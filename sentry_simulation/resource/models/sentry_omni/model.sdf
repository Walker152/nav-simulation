<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sentry">
    <self_collide>false</self_collide>
    <link name="base_link">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>35.0</mass>
        <inertia><ixx>0.80</ixx><iyy>0.80</iyy><izz>1.20</izz></inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.45 0.42 0.25</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.45 0.42 0.25</size></box></geometry>
        <material><ambient>0.16 0.20 0.26 1</ambient><diffuse>0.20 0.28 0.38 1</diffuse></material>
      </visual>
    </link>

    <link name="front_right_wheel"><pose>0.16 -0.235 0.10 -1.5708 0 0</pose><inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual></link>
    <link name="front_left_wheel"><pose>0.16 0.235 0.10 -1.5708 0 0</pose><inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual></link>
    <link name="rear_right_wheel"><pose>-0.16 -0.235 0.10 -1.5708 0 0</pose><inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual></link>
    <link name="rear_left_wheel"><pose>-0.16 0.235 0.10 -1.5708 0 0</pose><inertial><mass>0.6</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual></link>

    <joint name="front_right_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="front_left_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="rear_right_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>
    <joint name="rear_left_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz></axis></joint>

    <link name="sim_lidar">
      <pose>0 -0.20 0.58 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.06</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      <sensor name="sim_lidar" type="gpu_lidar">
        <topic>/sim/lidar</topic><update_rate>20</update_rate><always_on>true</always_on><visualize>false</visualize>
        <ignition_frame_id>sim_lidar</ignition_frame_id>
        <lidar><scan><horizontal><samples>375</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.122173</min_angle><max_angle>0.907571</max_angle></vertical></scan><range><min>0.10</min><max>40.0</max><resolution>0.02</resolution></range></lidar>
      </sensor>
      <sensor name="sim_imu" type="imu"><topic>/sim/imu</topic><update_rate>200</update_rate><always_on>true</always_on><ignition_frame_id>sim_lidar</ignition_frame_id></sensor>
    </link>
    <joint name="sim_lidar_joint" type="fixed"><parent>base_link</parent><child>sim_lidar</child></joint>

    <plugin filename="MecanumDrive2" name="ignition::gazebo::systems::MecanumDrive2">
      <chassis_link>base_link</chassis_link>
      <front_right_joint>front_right_joint</front_right_joint><front_left_joint>front_left_joint</front_left_joint>
      <rear_right_joint>rear_right_joint</rear_right_joint><rear_left_joint>rear_left_joint</rear_left_joint>
    </plugin>
  </model>
</sdf>
