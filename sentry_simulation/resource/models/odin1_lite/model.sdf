      <visual name="rear_connector_base_visual">
        <pose>-0.029 0 0.004 0 1.570796326795 0</pose>
        <geometry><cylinder><radius>0.0078</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.15 0.17 0.19 1</ambient><diffuse>0.27 0.30 0.33 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
