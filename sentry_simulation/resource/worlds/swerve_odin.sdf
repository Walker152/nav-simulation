<?xml version="1.0"?>
<!-- Chassis is inserted by swerve_platform.py from the launch-selected YAML. -->
<sdf version="1.9">
  <world name="swerve_odin">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.72 0.79 0.86 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.3 0.4 -1</direction><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></light>
    <model name="ground"><static>true</static><link name="ground">
      <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.42 0.46 0.48 1</ambient><diffuse>0.42 0.46 0.48 1</diffuse></material></visual>
    </link></model>
    <!-- Colored cardinal targets leave a 36 m square for driving checks. -->
    <model name="front_target"><static>true</static><pose>18 0 1 0 0 0</pose><link name="target">
      <collision name="target_collision"><geometry><box><size>0.2 4 2</size></box></geometry></collision>
      <visual name="target_visual"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.8 0.18 0.12 1</ambient><diffuse>0.8 0.18 0.12 1</diffuse></material></visual>
    </link></model>
    <model name="rear_target"><static>true</static><pose>-18 0 1 0 0 0</pose><link name="target">
      <collision name="target_collision"><geometry><box><size>0.2 4 2</size></box></geometry></collision>
      <visual name="target_visual"><geometry><box><size>0.2 4 2</size></box></geometry><material><ambient>0.18 0.35 0.8 1</ambient><diffuse>0.18 0.35 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="left_target"><static>true</static><pose>0 18 1 0 0 0</pose><link name="target">
      <collision name="target_collision"><geometry><box><size>4 0.2 2</size></box></geometry></collision>
      <visual name="target_visual"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.15 0.65 0.3 1</ambient><diffuse>0.15 0.65 0.3 1</diffuse></material></visual>
    </link></model>
    <model name="right_target"><static>true</static><pose>0 -18 1 0 0 0</pose><link name="target">
      <collision name="target_collision"><geometry><box><size>4 0.2 2</size></box></geometry></collision>
      <visual name="target_visual"><geometry><box><size>4 0.2 2</size></box></geometry><material><ambient>0.85 0.65 0.1 1</ambient><diffuse>0.85 0.65 0.1 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
