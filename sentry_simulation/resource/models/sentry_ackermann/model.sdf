<?xml version="1.0"?>
<sdf version="1.7">
  <model name="sentry" xmlns:ignition="http://ignitionrobotics.org/schema">
    <!-- Independent simulation prototype, not measured hardware parameters.
         Rear-axle XY origin; wheelbase/track 0.44 m, wheel radius 0.076 m.
         The navigation envelope is center steering +/-0.4 rad.
         Existing sensor coordinates remain in this model frame. -->
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <pose>0.22 0 0 0 0 0</pose>
        <mass>35.0</mass>
        <inertia><ixx>0.583333</ixx><iyy>0.583333</iyy><izz>0.933333</izz></inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0.22 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.40 0.40 0.16</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><ode><kp>1000000</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
      <visual name="base_visual">
        <pose>0.22 0 -0.175736785 0 0 0</pose>
        <geometry><mesh><uri>model://pb2025_visuals/meshes/chassis_base.dae</uri><scale>1 1 0.852565282</scale></mesh></geometry>
      </visual>
    </link>

    <link name="front_left_knuckle">
      <pose>0.44 0.22 0.076 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz></inertia></inertial>
    </link>
    <link name="front_left_wheel">
      <pose>0.44 0.22 0.076 -1.57079632679 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.0009464</ixx><iyy>0.0009464</iyy><izz>0.0017328</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="front_right_knuckle">
      <pose>0.44 -0.22 0.076 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz></inertia></inertial>
    </link>
    <link name="front_right_wheel">
      <pose>0.44 -0.22 0.076 -1.57079632679 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.0009464</ixx><iyy>0.0009464</iyy><izz>0.0017328</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="rear_left_wheel">
      <pose>0 0.22 0.076 -1.57079632679 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.0009464</ixx><iyy>0.0009464</iyy><izz>0.0017328</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>0 -0.22 0.076 -1.57079632679 0 0</pose>
      <inertial><mass>0.6</mass><inertia><ixx>0.0009464</ixx><iyy>0.0009464</iyy><izz>0.0017328</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.076</radius><length>0.04</length></cylinder></geometry></visual>
    </link>

    <!-- Center delta=0.4 gives an inner-wheel angle of 0.492132 rad, so
         +/-0.52 leaves mechanical clearance. This is an uncalibrated prototype;
         use Gazebo's 1 rad/s Ackermann baseline instead of imposing a second
         planner steering-rate envelope in the simulator. -->
    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_left_knuckle</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.52</lower><upper>0.52</upper><effort>50</effort><velocity>1.0</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="front_left_joint" type="revolute">
      <parent>front_left_knuckle</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><effort>50</effort><velocity>60</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_right_knuckle</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.52</lower><upper>0.52</upper><effort>50</effort><velocity>1.0</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="front_right_joint" type="revolute">
      <parent>front_right_knuckle</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><effort>50</effort><velocity>60</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="rear_left_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><effort>50</effort><velocity>60</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>
    <joint name="rear_right_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><effort>50</effort><velocity>60</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis>
    </joint>

    <!-- Level common LiDAR/IMU frame used by Point-LIO after both sensors are fused. -->
    <link name="sim_lidar">
      <pose>0 -0.2 0.3 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial>
      <sensor name="sim_imu" type="imu"><topic>/sim/imu</topic><update_rate>200</update_rate><always_on>true</always_on><ignition_frame_id>sim_lidar</ignition_frame_id></sensor>
    </link>
    <joint name="sim_lidar_joint" type="fixed"><parent>base_link</parent><child>sim_lidar</child></joint>

    <link name="sim_lidar_left">
      <pose>-0.0496 0.136 0.274965449328 -0.5835987756 0 0</pose>
      <inertial><mass>0.265</mass><inertia><ixx>0.000173</ixx><iyy>0.000173</iyy><izz>0.000187</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.065 0.060 0.065</size></box></geometry></collision>
      <visual name="visual"><pose>0 0 0 0 0 3.14159265359</pose><geometry><mesh><uri>model://mid360/meshes/mid360.dae</uri></mesh></geometry></visual>
      <sensor name="sim_lidar_left_front" type="gpu_lidar">
        <pose>0 0 0.03 0 0 0</pose>
        <topic>/sim/lidar/left/front</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
        <ignition_frame_id>sim_lidar_left</ignition_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.57079632679</min_angle><max_angle>1.57079632679</max_angle></horizontal><vertical><samples>120</samples><resolution>1</resolution><min_angle>-0.1274090354</min_angle><max_angle>0.9128076904</max_angle></vertical></scan>
          <range><min>0.10</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
        </lidar>
      </sensor>
      <sensor name="sim_lidar_left_rear" type="gpu_lidar">
        <pose>0 0 0.03 0 0 3.14159265359</pose>
        <topic>/sim/lidar/left/rear</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
        <ignition_frame_id>sim_lidar_left</ignition_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.57079632679</min_angle><max_angle>1.57079632679</max_angle></horizontal><vertical><samples>120</samples><resolution>1</resolution><min_angle>-0.1274090354</min_angle><max_angle>0.9128076904</max_angle></vertical></scan>
          <range><min>0.10</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="sim_lidar_left_joint" type="fixed"><parent>base_link</parent><child>sim_lidar_left</child></joint>

    <link name="sim_lidar_right">
      <pose>-0.0496 -0.136 0.274965449328 0.5835987756 0 0</pose>
      <inertial><mass>0.265</mass><inertia><ixx>0.000173</ixx><iyy>0.000173</iyy><izz>0.000187</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.065 0.060 0.065</size></box></geometry></collision>
      <visual name="visual"><pose>0 0 0 0 0 3.14159265359</pose><geometry><mesh><uri>model://mid360/meshes/mid360.dae</uri></mesh></geometry></visual>
      <sensor name="sim_lidar_right_front" type="gpu_lidar">
        <pose>0 0 0.03 0 0 0</pose>
        <topic>/sim/lidar/right/front</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
        <ignition_frame_id>sim_lidar_right</ignition_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.57079632679</min_angle><max_angle>1.57079632679</max_angle></horizontal><vertical><samples>120</samples><resolution>1</resolution><min_angle>-0.1274090354</min_angle><max_angle>0.9128076904</max_angle></vertical></scan>
          <range><min>0.10</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
        </lidar>
      </sensor>
      <sensor name="sim_lidar_right_rear" type="gpu_lidar">
        <pose>0 0 0.03 0 0 3.14159265359</pose>
        <topic>/sim/lidar/right/rear</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
        <ignition_frame_id>sim_lidar_right</ignition_frame_id>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.57079632679</min_angle><max_angle>1.57079632679</max_angle></horizontal><vertical><samples>120</samples><resolution>1</resolution><min_angle>-0.1274090354</min_angle><max_angle>0.9128076904</max_angle></vertical></scan>
          <range><min>0.10</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.0</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="sim_lidar_right_joint" type="fixed"><parent>base_link</parent><child>sim_lidar_right</child></joint>

    <!-- Rear wheel drive and front steering have one command owner.
         Gazebo 6.18 uses R_min=L/sin(limit), so limit=asin(tan(0.4)).
         Twist remains rear-axle forward speed and yaw rate; zero requests recentering. -->
    <plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_joint</left_joint><right_joint>rear_right_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_base>0.44</wheel_base><wheel_separation>0.44</wheel_separation><kingpin_width>0.44</kingpin_width>
      <wheel_radius>0.076</wheel_radius><steering_limit>0.436525365377011</steering_limit>
      <topic>/sentry/cmd_vel</topic>
      <odom_topic>/sentry/wheel_odometry</odom_topic><tf_topic>/sentry/wheel_odometry_tf</tf_topic>
      <frame_id>sentry/odom</frame_id><child_frame_id>sentry/base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>front_left_steering_joint</joint_name>
      <joint_name>front_right_steering_joint</joint_name>
      <topic>/sentry/steering_joint_state</topic>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>sentry/odom</odom_frame><robot_base_frame>sentry/base_link</robot_base_frame>
      <dimensions>3</dimensions><odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/sentry/ground_truth_odometry</odom_topic><tf_topic>/sentry/ground_truth_tf</tf_topic>
    </plugin>
  </model>
</sdf>
