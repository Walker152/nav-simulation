Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 40; 45
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 40
  - Class: rviz_default_plugins/RobotModel
    Name: Four swerve / four Odin
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
  - Class: rviz_default_plugins/PointCloud2
    Name: front Odin
    Enabled: true
    Topic:
      Value: /sim/odin_front/points
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 1
    Size (m): 0.015
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 80; 60
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: rear Odin
    Enabled: true
    Topic:
      Value: /sim/odin_rear/points
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 1
    Size (m): 0.015
    Style: Points
    Color Transformer: FlatColor
    Color: 80; 130; 255
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: left Odin
    Enabled: true
    Topic:
      Value: /sim/odin_left/points
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 1
    Size (m): 0.015
    Style: Points
    Color Transformer: FlatColor
    Color: 60; 220; 100
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: right Odin
    Enabled: true
    Topic:
      Value: /sim/odin_right/points
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 1
    Size (m): 0.015
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 210; 50
    Decay Time: 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: base_link
      Distance: 2.5
      Pitch: 0.45
      Yaw: 0.75
      Focal Point:
        X: 0
        Y: 0
        Z: 0.2
